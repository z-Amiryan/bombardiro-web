{
  "name": "bombardiro-web",
  "version": "1.0.0",
  "private": true,
  "description": "The website for Bombardiro, a football party word game for iPhone and iPad.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/serve.mjs",
    "check": "npm run check:types && npm run lint && npm run test:unit && npm run check:copy",
    "check:types": "astro check",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "check:copy": "node scripts/check-copy.mjs",
    "check:site": "node scripts/check-site.mjs",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun; status=$?; node scripts/lighthouse-summary.mjs; exit $status",
    "build:og": "node scripts/build-og.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-armenian": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "astro": "7.4.4",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "fontkitten": "1.0.3",
    "globals": "17.14.0",
    "node": "24.22.2",
    "qrcode-generator": "2.0.4",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "ultrahtml": "1.7.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "node@24.22.2": true
  }
}
