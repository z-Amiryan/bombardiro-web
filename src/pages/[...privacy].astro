---
// Privacy (design/export/Privacy.dc.html, the chalk reading surface): the website's privacy notice, with a
// link to the app's own policy.
import Icon from '../components/Icon.astro';
import { APP_PRIVACY_URL, LAST_UPDATED } from '../config/site';
import Base from '../layouts/Base.astro';
import { copyFor } from '../lib/copy';
import { formatDate } from '../lib/dates';
import { staticPathsFor, type Lang } from '../lib/routes';

export function getStaticPaths() {
  return staticPathsFor('privacy', 'privacy');
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copyFor(lang).pages.privacy;
const date = formatDate(lang, LAST_UPDATED);
const [before = '', after = ''] = t.updated.split('{date}');
---

<Base lang={lang} routeId="privacy" surface="chalk" title={t.meta.title} description={t.meta.description}>
  <div class="privacy wrap">
    <div class="side">
      <h1 class="h1 display fit"><span class="fit__t">{t.h1}</span></h1>
      <p class="updated">{before}<time datetime={LAST_UPDATED}>{date}</time>{after}</p>
      <p class="intro">{t.intro}</p>
      <a class="app-policy" href={APP_PRIVACY_URL} rel="noopener">
        {t.appPolicyLabel}
        <Icon name="arrow-up-right" />
      </a>
    </div>
    <div class="sections">
      {
        t.sections.map((s, i) => (
          <section class="sec" aria-labelledby={`privacy-${i + 1}`}>
            <span class="sec__n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h2 id={`privacy-${i + 1}`} class="sec__title display">
                {s.title}
              </h2>
              <p class="sec__text">{s.text}</p>
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .privacy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px 96px;
    align-items: start;
    padding-block: 36px 72px;
  }
  .h1 {
    --fs: calc(clamp(36px, 4vw, 60px) * var(--k));
    --ls: -0.02em;
    line-height: 0.98;
    text-transform: none;
    text-wrap: balance;
    /* The longest word, in em (.fit in base.css). */
    --fit: 4.25;
  }
  :global(:root[lang='ru']) .h1 {
    --fit: 10.85;
  }
  :global(:root[lang='hy']) .h1 {
    --fit: 8.5;
  }
  .updated {
    margin-top: 16px;
    font: 600 13px/1.3 var(--fu);
    color: var(--fg-muted);
  }
  .intro {
    margin-top: 22px;
    max-width: 34ch;
    font: 400 16px/1.6 var(--fu);
    color: var(--c-chalk-text);
  }
  .app-policy {
    margin-top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font: 700 15px/1.2 var(--fu);
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .sections {
    max-width: 720px;
  }
  .sec {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 8px 24px;
    padding: 24px 0 26px;
    border-top: 1px solid var(--rule);
  }
  .sec:first-child {
    border-top: 3px solid var(--fg);
  }
  .sec__n {
    font: 700 12px/1.8 var(--fu);
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .sec__title {
    margin-bottom: 8px;
    font-size: calc(22px * var(--k));
    line-height: 1.15;
    text-transform: none;
  }
  .sec__text {
    font: 400 17px/1.65 var(--fu);
    color: var(--fg-body);
    text-wrap: pretty;
  }

  @media (min-width: 1000px) {
    .privacy {
      grid-template-columns: 420px minmax(0, 1fr);
      padding-block: 64px 120px;
    }
    .side {
      position: sticky;
      top: 120px;
    }
    .sec {
      grid-template-columns: 40px minmax(0, 1fr);
    }
  }
</style>
