---
import { copyFor } from '../lib/copy';
import { LANGS, routePath } from '../lib/routes';

const blocks = LANGS.map((lang) => ({ lang, t: copyFor(lang) }));
// The status code is the same in every language, so it is the page's one h1 and starts its title.
const code = copyFor('en').notFound.code;
const title = [code, ...blocks.map((b) => b.t.notFound.title)].join(' · ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title}</title>
  </head>
  <body>
    <main id="main">
      <h1>{code}</h1>
      {
        blocks.map(({ lang, t }) => (
          <section lang={lang}>
            <h2>{t.notFound.title}</h2>
            <p>{t.notFound.text}</p>
            <a href={routePath('home', lang)} hreflang={lang}>
              {t.notFound.home}
            </a>
          </section>
        ))
      }
    </main>
  </body>
</html>
