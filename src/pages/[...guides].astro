---
import PageIntro from '../components/PageIntro.astro';
import Base from '../layouts/Base.astro';
import { copyFor } from '../lib/copy';
import { staticPathsFor, type Lang } from '../lib/routes';

export function getStaticPaths() {
  return staticPathsFor('guides', 'guides');
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copyFor(lang).pages.guides;
---

<Base lang={lang} routeId="guides" surface="chalk" bp={1000} title={t.meta.title} description={t.meta.description}>
  <PageIntro h1={t.h1} lead={t.lead} />
</Base>
