---
// How to play (design/export/HowToPlay.dc.html): the rules, the 25-second app recording, the match
// settings, fair play and describing tips, then the store badge.
import BadgeLine from '../components/BadgeLine.astro';
import Icon from '../components/Icon.astro';
import Screenshot from '../components/Screenshot.astro';
import Base from '../layouts/Base.astro';
import { copyFor } from '../lib/copy';
import { routePath, staticPathsFor, type Lang } from '../lib/routes';

export function getStaticPaths() {
  return staticPathsFor('howToPlay', 'howToPlay');
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = copyFor(lang);
// The real 25-second capture (scripts/build-video.mjs), the same in every language.
const VIDEO = '/video/app-preview-en.mp4';
const POSTER = '/video/app-preview-en.webp';
const t = c.pages.howToPlay;

const toc = [
  { href: '#rules', label: t.stepsTitle },
  { href: '#video', label: t.video.title },
  { href: '#settings', label: t.settings.title },
  { href: '#fair', label: t.fair.title },
  { href: '#tips', label: t.tips.title },
];

// "Players: try the club…" sets its lead-in in bold. Armenian writes the lead-in with ՝.
const tips = t.tips.items.map((item) => {
  const m = item.match(/^([^:՝]{2,28}[:՝])\s*(.*)$/u);
  return m ? { head: m[1] ?? '', body: m[2] ?? '' } : { head: '', body: item };
});
---

<Base lang={lang} routeId="howToPlay" surface="night" bp={1100} title={t.meta.title} description={t.meta.description}>
  <section class="hero" aria-labelledby="htp-title">
    <div class="hero__bg" aria-hidden="true"><span class="hero__cone"></span></div>
    <div class="hero__in wrap">
      <div>
        <p class="eyebrow">{c.brand.descriptor}</p>
        <h1 id="htp-title" class="hero__h1 display">{t.h1}</h1>
        <p class="hero__lead">{t.lead}</p>
      </div>
      <nav class="toc" aria-label={t.h1}>
        {
          toc.map((item) => (
            <a href={item.href}>
              {item.label}
              <Icon name="arrow-down" />
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section id="rules" class="sec wrap" aria-labelledby="rules-title">
    <h2 id="rules-title" class="h2 display">{t.stepsTitle}</h2>
    <div class="rules">
      <ol class="steps" role="list">
        {
          t.steps.map((step, i) => (
            <li class="step">
              <span class="step__n display" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="step__title display">{step.title}</h3>
                <p class="body">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="side-shot">
        <Screenshot lang={lang} id="categories" width={280} sizes="280px" />
      </div>
    </div>
  </section>

  <section id="video" class="video" aria-labelledby="video-title">
    <div class="video__in wrap">
      <div>
        <p class="video__stamp display" aria-hidden="true">00:25</p>
        <h2 id="video-title" class="h2 video__title display">{t.video.title}</h2>
        <p id="video-caption" class="video__caption">{t.video.caption}</p>
      </div>
      <div class="video__media">
        <div class="player" data-player>
          <video
            class="player__video"
            playsinline
            preload="none"
            poster={POSTER}
            width="660"
            height="1430"
            data-src={VIDEO}
            aria-labelledby="video-title"
            aria-describedby="video-caption"
            hidden></video>
          <noscript>
            <video
              class="player__video"
              controls
              playsinline
              preload="none"
              poster={POSTER}
              width="660"
              height="1430"
              aria-labelledby="video-title"
              aria-describedby="video-caption"
            >
              <source src={VIDEO} type="video/mp4" />
            </video>
          </noscript>
          <button type="button" class="player__play" data-play hidden>
            <span class="sr-only">{t.video.play}</span>
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M7 4.5v15l12.5-7.5z"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <section id="settings" class="sec wrap" aria-labelledby="settings-title">
    <div class="settings">
      <div class="side-shot">
        <Screenshot lang={lang} id="settings" width={280} sizes="280px" />
      </div>
      <div>
        <h2 id="settings-title" class="h2 display">{t.settings.title}</h2>
        <dl class="dl">
          {
            t.settings.items.map((item) => (
              <div class="dl__row">
                <dt>
                  <span class="dl__label">{item.label}</span>
                  <span class="dl__value display">{item.value}</span>
                </dt>
                <dd class="body">{item.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="extras" aria-labelledby="fair-title">
    <div class="extras__in wrap">
      <div id="fair">
        <h2 id="fair-title" class="h3 display">{t.fair.title}</h2>
        <ul class="list" role="list">
          {
            t.fair.items.map((item) => (
              <li class="list__item list__item--dot">
                <span class="list__dot" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div id="tips">
        <h2 class="h3 display">{t.tips.title}</h2>
        <ul class="list" role="list">
          {
            tips.map((tip) => (
              <li class="list__item">
                {tip.head && <b>{tip.head}</b>} {tip.body}
              </li>
            ))
          }
        </ul>
        <a class="more" href={routePath('words', lang)}>
          {c.nav.words}
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>

  <section class="cta" aria-labelledby="cta-title">
    <span class="cta__cone" aria-hidden="true"></span>
    <div class="cta__in wrap">
      <p id="cta-title" class="cta__title display">{c.pages.home.final.title}</p>
      <BadgeLine lang={lang} placement="howto" />
    </div>
  </section>
</Base>

<script>
  // The design's lime play button over the poster. The video gets its source only when played, because some
  // browsers (WebKit) fetch a <source> on load whatever preload says. Without JavaScript, the <noscript> copy
  // shows the browser's own controls.
  for (const player of document.querySelectorAll<HTMLElement>('[data-player]')) {
    const video = player.querySelector<HTMLVideoElement>('video[data-src]');
    const play = player.querySelector<HTMLButtonElement>('[data-play]');
    if (!video || !play) continue;
    video.hidden = false;
    play.hidden = false;
    play.addEventListener('click', () => {
      video.src = video.dataset.src ?? '';
      video.controls = true;
      play.hidden = true;
      video.focus();
      void video.play().catch(() => undefined);
    });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(90% 80% at 70% 0%, var(--c-night-glow) 0%, var(--c-night) 60%);
  }
  .hero__cone {
    position: absolute;
    right: 8%;
    top: -120px;
    width: 620px;
    height: 1000px;
    transform: rotate(18deg);
    transform-origin: 50% 0;
    background: linear-gradient(180deg, rgb(var(--c-ink-hi-ch) / 0.11) 0%, rgb(var(--c-ink-hi-ch) / 0.03) 50%, rgb(var(--c-ink-hi-ch) / 0) 82%);
    clip-path: polygon(44% 0, 56% 0, 100% 100%, 0 100%);
  }
  .hero__in {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px 96px;
    align-items: end;
    padding-block: 40px 56px;
  }
  .hero__h1 {
    margin-top: 18px;
    font-size: calc(clamp(52px, 9vw, 148px) * var(--k));
    line-height: 0.88;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .hero__lead {
    margin-top: 22px;
    max-width: 28ch;
    font: 500 clamp(18px, 1.7vw, 24px) / 1.4 var(--fu);
    color: var(--fg-body);
  }

  .toc {
    display: flex;
    flex-direction: column;
    border-top: 1px dashed var(--rule-dash);
  }
  .toc a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 52px;
    border-bottom: 1px dashed var(--rule-dash);
    font: 500 16px/1.25 var(--fu);
    color: var(--c-ink-soft);
    text-decoration: none;
    transition: color 0.16s;
  }
  .toc a :global(.icon) {
    color: var(--accent);
  }
  @media (hover: hover) {
    .toc a:hover {
      color: var(--accent);
    }
  }

  .sec {
    padding-block: 64px;
  }
  .h2 {
    margin-bottom: 24px;
    font-size: calc(clamp(34px, 4.4vw, 64px) * var(--k));
    line-height: 0.95;
    letter-spacing: -0.012em;
  }
  .h3 {
    margin-bottom: 28px;
    font-size: calc(clamp(30px, 3.4vw, 48px) * var(--k));
    line-height: 0.95;
    letter-spacing: -0.01em;
  }
  .body {
    font: 400 16px/1.55 var(--fu);
    color: var(--fg-body);
    text-wrap: pretty;
  }

  .rules,
  .settings {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px 96px;
    align-items: start;
  }
  .side-shot {
    display: none;
  }
  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 48px;
  }
  .step {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 0 12px;
    padding: 26px 0 30px;
    border-top: 1px solid var(--rule);
  }
  .step__n {
    font-size: 44px;
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
    color: transparent;
    -webkit-text-stroke: 1.2px var(--accent);
  }
  .step__title {
    margin: 2px 0 10px;
    font-size: calc(24px * var(--k));
    line-height: 1.05;
    letter-spacing: -0.005em;
  }

  .video {
    background: var(--c-night-deep);
    border-block: 1px solid rgb(var(--c-ink-hi-ch) / 0.08);
  }
  .video__in {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px 96px;
    align-items: center;
    padding-block: 64px;
  }
  .video__stamp {
    font-size: clamp(28px, 2.6vw, 36px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .video__title {
    margin: 16px 0 14px;
  }
  .video__caption {
    max-width: 34ch;
    font: 400 17px/1.55 var(--fu);
    color: var(--fg-body);
  }
  .video__media {
    display: flex;
    justify-content: center;
  }
  .player {
    position: relative;
    width: min(268px, 72vw);
    aspect-ratio: 660 / 1430;
    border-radius: var(--r-shot);
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--c-night-deep);
  }
  .player__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .player__video[hidden] {
    display: none;
  }
  .player__play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 76px;
    height: 76px;
    margin: -38px 0 0 -38px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0 0 4px;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: 0 0 0 10px rgb(var(--c-lime-ch) / 0.12);
    cursor: pointer;
    transition: transform 0.16s var(--ease-out);
  }
  .player__play[hidden] {
    display: none;
  }
  .player__play svg {
    fill: currentColor;
  }
  @media (hover: hover) {
    .player__play:hover {
      transform: scale(1.06);
    }
  }
  .player__play:active {
    transform: scale(0.94);
  }

  .dl__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px 32px;
    padding: 24px 0;
    border-top: 1px solid var(--rule);
  }
  .dl__row dt {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .dl__label {
    font: 600 12px/1.2 var(--fu);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .dl__value {
    font-size: calc(24px * var(--k));
    line-height: 1.05;
    color: var(--accent);
  }

  .extras {
    border-top: 1px solid rgb(var(--c-ink-hi-ch) / 0.08);
  }
  .extras__in {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 64px 96px;
    padding-block: 64px;
  }
  .list__item {
    padding: 16px 0;
    border-top: 1px dashed var(--rule-dash);
    font: 400 16px/1.55 var(--fu);
    color: var(--fg-body);
    text-wrap: pretty;
  }
  .list__item b {
    font-weight: 700;
    color: var(--fg);
  }
  .list__item--dot {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 12px;
  }
  .list__dot {
    width: 12px;
    height: 12px;
    margin-top: 6px;
    border-radius: 50%;
    border: 2px solid var(--accent);
  }
  .more {
    margin-top: 24px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font: 700 15px/1 var(--fu);
    color: var(--accent);
    text-decoration: none;
  }
  @media (hover: hover) {
    .more:hover {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 5px;
      text-decoration-thickness: 2px;
    }
  }

  .cta {
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgb(var(--c-ink-hi-ch) / 0.08);
  }
  .cta__cone {
    position: absolute;
    left: 50%;
    top: -60px;
    width: 800px;
    height: 800px;
    margin-left: -400px;
    background: linear-gradient(180deg, rgb(var(--c-ink-hi-ch) / 0.09) 0%, rgb(var(--c-ink-hi-ch) / 0) 80%);
    clip-path: polygon(42% 0, 58% 0, 100% 100%, 0 100%);
    pointer-events: none;
  }
  .cta__in {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding-block: 72px 88px;
    text-align: center;
  }
  .cta__title {
    max-width: 16ch;
    font-size: calc(clamp(36px, 5vw, 72px) * var(--k));
    line-height: 0.92;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .cta :global(.badge-line__note) {
    text-align: left;
  }

  @media (min-width: 1100px) {
    .hero__in {
      grid-template-columns: minmax(0, 1fr) 400px;
      padding-block: 72px 96px;
    }
    .sec,
    .video__in,
    .extras__in {
      padding-block: 120px;
    }
    .h2 {
      margin-bottom: 40px;
    }
    .rules {
      grid-template-columns: minmax(0, 1fr) 300px;
    }
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .settings {
      grid-template-columns: 300px minmax(0, 1fr);
    }
    .side-shot {
      position: sticky;
      top: 120px;
      display: flex;
      justify-content: center;
    }
    .side-shot :global(.shot) {
      width: 280px;
    }
    .video__in {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .player {
      width: 300px;
    }
    .dl__row {
      grid-template-columns: 260px minmax(0, 1fr);
    }
    .extras__in {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cta__in {
      padding-block: 120px 140px;
    }
  }
</style>
