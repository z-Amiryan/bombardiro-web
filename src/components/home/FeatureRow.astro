---
// A feature beside its real screen, on the centre-circle glow. Wide screens alternate the sides.
import type { Lang } from '../../lib/routes';
import type { ScreenId } from '../../lib/screens';
import Screenshot from '../Screenshot.astro';

interface Props {
  lang: Lang;
  n: number;
  title: string;
  text: string;
  shot: ScreenId;
  /** Screen on the left on wide screens. */
  flip?: boolean;
}

const { lang, n, title, text, shot, flip = false } = Astro.props;
const id = `feature-${n}`;
---

<section class:list={['feature', { 'feature--flip': flip }]} aria-labelledby={id}>
  <div class="feature__copy">
    <p class="eyebrow" aria-hidden="true">{String(n).padStart(2, '0')}</p>
    <h2 id={id} class="feature__title display">{title}</h2>
    <p class="feature__text">{text}</p>
  </div>
  <div class="feature__media">
    <span class="feature__circle" aria-hidden="true"></span>
    <Screenshot lang={lang} id={shot} width={304} sizes="(min-width: 1100px) 304px, min(268px, 72vw)" class="feature__shot" />
  </div>
</section>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px 96px;
    align-items: center;
  }

  .feature__title {
    margin: 16px 0 14px;
    font-size: calc(clamp(34px, 4.4vw, 64px) * var(--k));
    line-height: 0.95;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  .feature__text {
    max-width: 40ch;
    font: 400 clamp(16px, 1.3vw, 19px) / 1.55 var(--fu);
    color: var(--fg-body);
    text-wrap: pretty;
  }

  .feature__media {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .feature__circle {
    position: absolute;
    left: 50%;
    top: 50%;
    /* Whole on the narrowest phones too, never wider than the screen. */
    width: min(340px, 100vw - 24px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--c-ink-hi) 8%, transparent);
    background: radial-gradient(circle, color-mix(in srgb, var(--c-lime) 6%, transparent) 0%, transparent 62%);
  }

  .feature__media :global(.feature__shot) {
    position: relative;
    width: min(268px, 72vw);
  }

  @media (min-width: 1100px) {
    .feature {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .feature--flip .feature__copy {
      order: 2;
    }
    .feature--flip .feature__media {
      order: 1;
    }
    .feature__circle {
      width: 560px;
    }
    .feature__media :global(.feature__shot) {
      width: 304px;
    }
  }
</style>
