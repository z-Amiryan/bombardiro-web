---
// Everything in <head> that search engines and link previews read (handoff/SPEC.md §6): title, description,
// canonical, hreflang for every language version plus x-default, Open Graph and Twitter tags with a card per
// language, theme-color, icons, the App Store banner and JSON-LD.
import { APP_STORE_ID } from '../config/site';
import { copyFor } from '../lib/copy';
import { absoluteUrl, alternates, xDefaultPath, type Lang, type RouteId } from '../lib/routes';
import { graph } from '../lib/structured-data';
import { THEME_COLOR, type Surface } from '../lib/surface';

interface Props {
  lang: Lang;
  routeId: RouteId;
  path: string;
  title: string;
  description: string;
  surface: Surface;
  ogType?: 'website' | 'article';
  jsonLd: Record<string, unknown>[];
}

const { lang, routeId, path, title, description, surface, ogType = 'website', jsonLd } = Astro.props;
const t = copyFor(lang);
const OG_LOCALE: Record<Lang, string> = { en: 'en_US', ru: 'ru_RU', hy: 'hy_AM' };
const alts = alternates(routeId);
const ogImage = absoluteUrl(`/og/${lang}.jpg`);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={absoluteUrl(path)} />
{alts.map((a) => <link rel="alternate" hreflang={a.lang} href={absoluteUrl(a.path)} />)}
<link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefaultPath(routeId))} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={t.brand.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={absoluteUrl(path)} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
{alts.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={OG_LOCALE[a.lang]} />)}
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={t.pages.home.h1} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={t.pages.home.h1} />

<meta name="theme-color" content={THEME_COLOR[surface]} />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />

<script is:inline type="application/ld+json" set:html={graph(jsonLd)} />
