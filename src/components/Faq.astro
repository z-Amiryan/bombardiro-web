---
// Questions and answers as native disclosure widgets: they open with a click, Enter or Space, work with
// JavaScript off, and find-in-page searches inside them. Opening one closes the others (shared name).
// The answer fades in with opacity and transform only (no animated height).
interface Props {
  name: string;
  items: Array<{ q: string; a: string }>;
}

const { name, items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details name={name}>
        <summary>
          <span class="faq__q">{item.q}</span>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <p class="faq__a">{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--rule);
  }
  details {
    border-bottom: 1px solid var(--rule);
  }
  summary {
    min-height: 68px;
    padding: 16px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    cursor: pointer;
    list-style: none;
    font: 600 clamp(17px, 1.4vw, 20px) / 1.3 var(--fu);
    color: var(--fg);
    transition: color 0.16s;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  @media (hover: hover) {
    summary:hover {
      color: var(--accent);
    }
  }
  details[open] summary {
    color: var(--accent);
  }
  .faq__q {
    text-wrap: pretty;
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--rule-dash);
    transition: transform 0.24s var(--ease-out);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    margin: -0.75px 0 0 -6px;
    border-radius: 1px;
    background: var(--accent);
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  details[open] .faq__icon {
    transform: rotate(45deg);
  }
  .faq__a {
    padding: 0 56px 22px 0;
    font: 400 16px/1.6 var(--fu);
    color: var(--fg-body);
    text-wrap: pretty;
  }
  details[open] .faq__a {
    animation: faq-in 0.28s var(--ease-out);
  }
  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq__icon {
      transition: none;
    }
    details[open] .faq__a {
      animation: none;
    }
  }
</style>
